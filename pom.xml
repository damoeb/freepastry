<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.mpisws.p2p</groupId>
    <artifactId>freepastry</artifactId>
    <version>2.1.0</version>
    <packaging>jar</packaging>

    <name>FreePastry</name>
    <description>A modular, open-source implementation of the Pastry peer-to-peer structured overlay network</description>
    <url>http://freepastry.org/</url>

    <licenses>
        <license>
            <name>FreePastry License</name>
            <url>file://${project.basedir}/license/License.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <junit.version>6.1.3</junit.version>
    </properties>

    <dependencies>
        <!-- Bouncy Castle for cryptography -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.86</version>
        </dependency>

        <!-- Apache Commons JXPath for XML processing -->
        <dependency>
            <groupId>commons-jxpath</groupId>
            <artifactId>commons-jxpath</artifactId>
            <version>1.4.0</version>
        </dependency>

        <!-- Apache Commons Logging -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.4.0</version>
        </dependency>

        <!-- XML Pull Parser -->
        <dependency>
            <groupId>xmlpull</groupId>
            <artifactId>xmlpull</artifactId>
            <version>1.2.0</version>
        </dependency>

        <!-- XPP3 XML Parser -->
        <dependency>
            <groupId>xpp3</groupId>
            <artifactId>xpp3</artifactId>
            <version>1.1.4c</version>
        </dependency>

        <!-- 
        SBBI UPnP Library (optional - for UPnP NAT traversal support)
        Not available in Maven Central. If you need UPnP support, download from:
        http://sourceforge.net/projects/upnplib/
        And install to your local Maven repository with:
        mvn install:install-file -Dfile=sbbi-upnplib-1.0.4.jar \
            -DgroupId=net.sbbi -DartifactId=sbbi-upnplib -Dversion=1.0.4 -Dpackaging=jar
        
        Then uncomment this dependency:
        <dependency>
            <groupId>net.sbbi</groupId>
            <artifactId>sbbi-upnplib</artifactId>
            <version>1.0.4</version>
            <optional>true</optional>
        </dependency>
        -->

        <!-- JUnit 5 for testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
        </dependency>
        
        <!-- JUnit 4 for legacy tests (tests are in src/, not src/test/) -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
        </dependency>
        
        <!-- JUnit Vintage Engine to run JUnit 4 tests with JUnit 5 Platform -->
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>${junit.version}</version>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src</sourceDirectory>
        <resources>
            <resource>
                <directory>jars/freepastry</directory>
                <includes>
                    <include>freepastry.params</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <!-- Enforce the toolchain this build is verified with -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9.0,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[${maven.compiler.release},)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Build Helper Plugin to add src as test source -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>add-test-source</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <compilerArgs>
                        <!-- No raw (untyped) generics and no deprecated API usage: either fails the build -->
                        <arg>-Xlint:rawtypes,deprecation,removal,dep-ann</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                    <showDeprecation>true</showDeprecation>
                    <debuglevel>lines,vars,source</debuglevel>
                    <debug>true</debug>
                    <!--  Exclude files that require optional libraries or are incompatible with newer library versions -->
                    <excludes>
                        <exclude>**/rice/pastry/socket/nat/sbbi/**</exclude>
                        <exclude>**/pki/**</exclude>
                        <exclude>**/SSLTest*.java</exclude>
                        <exclude>**/peerreview/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- Also apply excludes to test compilation -->
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <testExcludes>
                                <exclude>**/rice/pastry/socket/nat/sbbi/**</exclude>
                                <exclude>**/pki/**</exclude>
                                <exclude>**/SSLTest*.java</exclude>
                                <exclude>**/peerreview/**</exclude>
                            </testExcludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven JAR Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifestFile>META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                    <finalName>freepastry-${project.version}</finalName>
                </configuration>
            </plugin>

            <!-- Maven Javadoc Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <doctitle>Rice Pastry API</doctitle>
                    <windowtitle>Rice Pastry - API Specifications</windowtitle>
                    <bottom><![CDATA[<i>Copyright &#169; 2001-2025 - Rice Pastry.</i>]]></bottom>
                    <sourceFileIncludes>
                        <include>org/mpisws/p2p/**/*.java</include>
                        <include>rice/*.java</include>
                        <include>rice/environment/**/*.java</include>
                        <include>rice/p2p/commonapi/**/*.java</include>
                        <include>rice/p2p/glacier/*.java</include>
                        <include>rice/p2p/glacier/v2/**/*.java</include>
                        <include>rice/p2p/aggregation/**/*.java</include>
                        <include>rice/p2p/multiring/**/*.java</include>
                        <include>rice/p2p/past/**/*.java</include>
                        <include>rice/p2p/replication/**/*.java</include>
                        <include>rice/p2p/scribe/**/*.java</include>
                        <include>rice/p2p/splitstream/**/*.java</include>
                        <include>rice/p2p/util/**/*.java</include>
                        <include>rice/pastry/**/*.java</include>
                        <include>rice/persistence/**/*.java</include>
                        <include>rice/selector/**/*.java</include>
                        <include>rice/tutorial/**/*.java</include>
                    </sourceFileIncludes>
                    <sourceFileExcludes>
                        <exclude>rice/p2p/saar/**/*.java</exclude>
                        <exclude>rice/pastry/socket/testing/*.java</exclude>
                    </sourceFileExcludes>
                </configuration>
            </plugin>

            <!-- Maven Surefire Plugin for running tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <excludes>
                        <!-- Exclude the same files we exclude from compilation -->
                        <exclude>**/rice/pastry/socket/nat/sbbi/**</exclude>
                        <exclude>**/pki/**</exclude>
                        <exclude>**/SSLTest*.java</exclude>
                        <exclude>**/peerreview/**</exclude>
                    </excludes>
                    <!-- Run tests sequentially to avoid port conflicts -->
                    <forkCount>1</forkCount>
                    <reuseForks>false</reuseForks>
                    <!-- Give tests more time and memory -->
                    <forkedProcessTimeoutInSeconds>300</forkedProcessTimeoutInSeconds>
                    <argLine>-Xmx1024m</argLine>
                </configuration>
            </plugin>

            <!-- Maven Assembly Plugin for creating distribution -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

